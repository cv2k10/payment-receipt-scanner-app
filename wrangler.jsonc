{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payment-receipt-scanner-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "payment-receipt-scanner-app"
    }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payment-receipt-scanner-db",
      // Placeholder for local dev. The GitHub Actions deploy workflow creates the
      // D1 database if needed and replaces this with the real database_id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    // Separate testing deployment: its own Worker URL and its own D1 database.
    // Deploy with: npx opennextjs-cloudflare deploy --env test
    "test": {
      "name": "payment-receipt-scanner-app-test",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "payment-receipt-scanner-app-test"
        }
      ],
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "payment-receipt-scanner-db-test",
          // Placeholder; the deploy workflow fills in the real test database_id.
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
